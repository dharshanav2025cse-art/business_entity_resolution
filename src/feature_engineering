            "candidate_name_missing":
                candidate_name_missing,

            "source1_address_missing":
                source1_address_missing,

            "candidate_address_missing":
                candidate_address_missing,

            "source1_country_missing":
                source1_country_missing,

            "candidate_country_missing":
                candidate_country_missing,

            "label":
                labels
        },
        columns=feature_columns
    )


    # ========================================================
    # WRITE CHUNK
    # ========================================================

    output_df.to_csv(
        OUTPUT_FILE,
        sep="\t",
        index=False,
        mode="w" if first_write else "a",
        header=first_write,
        compression="gzip"
    )


    first_write = False


    print(
        f"  Chunk complete | "
        f"Rows: {total_rows:,} | "
        f"Positive: {positive_rows:,}"
    )


# ============================================================
