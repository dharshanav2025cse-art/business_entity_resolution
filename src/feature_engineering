def safe_text_series(series):
    return (
        series
        .fillna("")
        .astype(str)
    )


def normalize_basic(text):
    if not text:
        return ""

    text = unicodedata.normalize(
        "NFKD",
        str(text)
    )

    text = "".join(
        c
        for c in text
        if not unicodedata.combining(c)
    )

    text = text.lower()

    text = re.sub(
        r"[^a-z0-9\s]",
        " ",
        text
    )

    text = re.sub(
        r"\s+",
        " ",
        text
    ).strip()

    return text


def jaccard_pair(a, b):
    """
    Token Jaccard similarity for one pair.
    Used only as a fallback for rows where the
    normalized token strings are not identical.
    """

    if not a and not b:
        return 1.0

    if not a or not b:
        return 0.0

    a_set = set(a.split())
    b_set = set(b.split())

    if not a_set and not b_set:
        return 1.0

    union = a_set | b_set

    if not union:
        return 0.0

    return len(a_set & b_set) / len(union)


def calculate_jaccard_series(
    left,
    right
):
    """
    Calculate Jaccard similarity in chunks.

    Exact token matches are handled immediately.
    Only non-exact rows need set operations.
    """

    result = np.zeros(
        len(left),
        dtype=np.float32
    )

    left_values = left.to_numpy()
    right_values = right.to_numpy()

    exact_mask = (
        (left_values == right_values)
        & (left_values != "")
    )

    result[exact_mask] = 1.0

    different_indices = np.where(
        ~exact_mask
    )[0]

    for idx in different_indices:

        a = left_values[idx]
        b = right_values[idx]

        if not a or not b:
            result[idx] = 0.0
            continue

        result[idx] = jaccard_pair(
            a,
            b
        )

    return result


