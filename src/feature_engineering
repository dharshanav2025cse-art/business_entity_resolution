            for pair in pair_keys
        ),
        dtype=np.int8,
        count=len(pair_keys)
    )


    positive_rows += int(
        labels.sum()
    )


    total_rows += len(chunk)


    # ========================================================
    # BUILD OUTPUT
    # ========================================================

    output_df = pd.DataFrame(
        {
            "source1_entity_id":
                chunk[
                    "source1_entity_id"
                ].values,

            "candidate_entity_id":
                chunk[
                    "candidate_entity_id"
                ].values,

            "candidate_source":
                chunk[
                    "candidate_source"
                ].values,

            "name_exact":
                name_exact,

            "name_token_exact":
                name_token_exact,

            "name_jaccard":
                name_jaccard,

            "name_length_difference":
